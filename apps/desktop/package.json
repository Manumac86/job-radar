{
  "name": "@job-radar/desktop",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Job Radar as a native macOS app (local build, unsigned, no auto-update)",
  "main": "dist/main.mjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
