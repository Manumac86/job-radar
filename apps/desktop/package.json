    "build:app": "tsx scripts/build-app.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "@electron/rebuild": "4.2.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  },
  "productName": "Job Radar",
  "author": "Job Radar (local build)"
}
